pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Restore') {
            steps {
                sh 'dotnet restore StudentUtility.slnx'
            }
        }

        stage('Build') {
            steps {
                sh 'dotnet build StudentUtility.slnx --no-restore'
            }
        }

        stage('Test') {
            steps {
                sh 'dotnet test StudentUtility.slnx --no-build'
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESSFUL - All tests passed!'
        }

        failure {
            echo 'BUILD FAILED - Check the console output.'
        }
    }
}